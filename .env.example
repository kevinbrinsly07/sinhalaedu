# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/sinhala_edu
REDIS_URL=redis://localhost:6379

# App Configuration
APP_NAME=Sinhala Exam Paper Generator
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here

# RAG Configuration
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=500
CHUNK_OVERLAP=100
